{
  "name": "sitevite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun vite build",
    "check": "bun run lint && bun run typecheck",
    "clean": "rm -rf dist",
    "dev": "bun vite",
    "done": "bun run lint && bun run format && bun run typecheck && bun vite build",
    "format": "bun biome format --write --verbose",
    "lint": "bun biome lint .",
    "preview": "bun vite preview",
    "test": "bun test",
    "test:ui": "vitest --ui",
    "test:all": "bun run test && bun run test:ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "bun": "^1.3.2",
    "cwip": "^1.1.22",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "biome": "^0.3.3",
    "bun-types": "^1.3.2",
    "globals": "^15.14.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.0.8",
    "vite": "^6.1.0",
    "vitest": "^4.0.8"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "author": "",
  "license": "ISC"
}
